# Client-side Auth Provider Configuration
# These variables are embedded in the client build
# Only include public app ID, NEVER include secrets

# Auth Provider App ID (public, safe to embed)
VITE_PRIVY_APP_ID=your_privy_app_id_here

# Alternative naming (generic):
VITE_AUTH_PROVIDER_APP_ID=your_app_id_here

# Note: Client-side code will NEVER reference the provider name
# All UI uses generic wording: "Continue", "Join Community", etc.
