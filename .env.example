# Auth Provider Configuration (Server-side)
# These variables are used by the backend to verify authentication
# DO NOT expose app secret to client-side code

# For local development:
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Alternative naming (generic):
AUTH_PROVIDER_APP_ID=your_app_id_here
AUTH_PROVIDER_APP_SECRET=your_app_secret_here

# JWT Secret for session tokens
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long

# TON Network Configuration
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2/

# Node Environment
NODE_ENV=development
